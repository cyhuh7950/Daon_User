# Daon User LLM Provider configuration
# Copy to .env locally or to /home/ubuntu/deploy/daon-user/.env on ysna-server.
# Never commit real keys.

# Provider credentials are encrypted in PostgreSQL. This file is the host-side
# path to the master key mounted read-only into API/provider-calling workers.
# Generate a private file with at least 32 random bytes; never commit its value.
DAON_PROVIDER_CREDENTIAL_KEY_FILE=/home/ubuntu/deploy/daon-user/secrets/provider_credential_key

# Runtime policy defaults. Named endpoint, credential, logical model IDs, and
# Workspace defaults are configured in the application UI.
LLM_DATA_REGION=
LLM_EXTERNAL_EGRESS_APPROVED=false

# Optional SMTP for signup verification and password reset mail delivery.
# Leave unset in development to make email delivery unavailable explicitly.
DAON_SMTP_HOST=
DAON_SMTP_PORT=587
DAON_SMTP_USERNAME=
DAON_SMTP_PASSWORD=
DAON_SMTP_SECURE=true
DAON_EMAIL_FROM=
