# Daon User LLM Provider configuration
# Copy to .env locally or to /home/ubuntu/deploy/daon-user/.env on ysna-server.
# Never commit real keys.

# Provider API keys currently supported by Daon2-compatible routing
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
UPSTAGE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# Upstage API (selected CP3 provider)
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_CHAT_MODEL=solar-pro3
UPSTAGE_VISION_MODEL=solar-docvision
UPSTAGE_DOCUMENT_PARSE_MODEL=document-parse
UPSTAGE_EMBEDDING_QUERY_MODEL=solar-embedding-1-large-query
UPSTAGE_EMBEDDING_PASSAGE_MODEL=solar-embedding-1-large-passage

# Optional local/internal model gateways (leave blank when unused)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_MODEL=

# Runtime policy
LLM_PROVIDER=upstage
LLM_DATA_REGION=
LLM_EXTERNAL_EGRESS_APPROVED=false
