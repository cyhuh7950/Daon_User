# Daon User LLM Provider configuration
# Copy to .env locally or to /home/ubuntu/deploy/daon-user/.env on ysna-server.
# Never commit real keys.

# Provider API keys currently supported by Daon2-compatible routing
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
UPSTAGE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# Runtime-only secret references and policy defaults. Provider URL, model ID,
# role mapping, and active selection are configured in the application UI.
LLM_DATA_REGION=
LLM_EXTERNAL_EGRESS_APPROVED=false
