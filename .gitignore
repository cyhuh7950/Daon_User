# Local agent scratch and review work
.superpowers/
.tmp_moaworks_review/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and generated build output
node_modules/
.venv/
dist/
build/
.next/
target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/gen/
apps/mobile/android/.gradle/
apps/mobile/android/app/.cxx/
__pycache__/
.pytest_cache/
.coverage
coverage/
htmlcov/
*.py[cod]

# Local runtime data
*.log
*.db
*.sqlite
*.sqlite3
.DS_Store
Thumbs.db

# Generated document QA output; keep source builder and final DOCX
docs/03_assets/design-renders*/
docs/.build/*-a11y*.json
docs/.build/*audit*.json
docs/.build/*lint*.json
docs/.build/*-pages*.png
docs/.build/*-montage*.png
docs/.build/page-*.png
docs/.build/*.pdf

# Office lock files
~$*.docx
~$*.xlsx
~$*.pptx

# Public repository boundary: publish user manuals only.
# Internal plans, designs, work orders, evidence and reports stay local.
*.md
*.mdx
*.docx
*.pdf
*.odt
*.rtf
/docs/*

# Signing material must never be published, including debug keys.
*.keystore
*.jks
*.p12
*.pfx

# Explicit public manual allowlist (canonical source and Web downloads).
!/docs/manual/
!/docs/manual/**
!/apps/web/public/manual/
!/apps/web/public/manual/**
